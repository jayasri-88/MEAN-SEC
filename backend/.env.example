# Copy to .env and fill ATLAS_URI
PORT=3001
MONGO_URI=mongodb://127.0.0.1:27017/meanlab
# For Atlas (production): mongodb+srv://<user>:<pass>@cluster0.xxxxx.mongodb.net/meanlab?retryWrites=true&w=majority
# ATLAS_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/meanlab?retryWrites=true&w=majority
JWT_SECRET=change_this_super_secret_in_production
USE_MEMORY_SERVER=true
# Set false when real MongoDB/Atlas is available; true uses mongodb-memory-server (no install)
